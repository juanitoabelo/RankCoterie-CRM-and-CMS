// Canopy V2 — draft Prisma schema (Phase 0)
// WIP: maps the legacy MariaDB (masternet.sql) into PostgreSQL per canopy-architecture.md §6.5 / §6.7.
// Naming follows the legacy domain (tbl* → PascalCase) so the migration script stays 1:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy / auth
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domainKey String   @unique // primary domain, e.g. "masternet.org" (legacy RFC_DOMAIN_NAME)
  theme     Json @default("{}") // brand theme (autoloaded by hostname)
  companyId String?  // resolves to a Company profile
  createdAt DateTime @default(now())
  users     User[]
  company   Company? @relation("TenantCompanyId", fields: [companyId], references: [id])
  companyProfile Company? @relation("CompanyTenant")
}

model User {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  email       String
  passwordHash String // argon2 — replaces legacy SHA1
  firstName   String?
  lastName    String?
  company     String?
  department  String?
  isRep       Boolean  @default(false) // legacy IsRep / IsCloser
  isCloser    Boolean  @default(false)
  authorUrl   String?  // staff/author pages
  authorBio   String?
  imageUrl    String?
  jobTitle    String?
  phone       String?
  socialMedia Json     @default("{}") // { facebook, instagram, twitter, youtube, linkedin, pinterest }
  undergraduateDegree    String?
  undergraduateInstitution String?
  postgraduateDegree     String?
  postgraduateInstitution String?
  doctorateDegree        String?
  doctorateInstitution   String?
  quickBiography  String?
  generalSkillsInfo String?
  includeInStaffPages Boolean @default(false)
  staffPageOrHomePage String?
  active      Boolean  @default(true)
  roles       UserRole[] // replaces tblUserPermissions
  createdAt   DateTime @default(now())
  // E-commerce relations
  vendorProducts         Product[]        @relation("ProductVendor")
  ordersAsCustomer       Order[]          @relation("OrderCustomer")
  ordersAsUser           Order[]          @relation("OrderUser")
  commissionsAsVendor    Commission[]     @relation("CommissionVendor")
  commissionsAsAffiliate Commission[]     @relation("CommissionAffiliate")
  carts                  Cart[]
  wishlists              Wishlist[]
  subscriptions          Subscription[]
  refundedRefunds        Refund[]
  orderNotes             OrderNote[]
  paymentTransactions    PaymentTransaction[]
  @@unique([tenantId, email])
}

enum Role {
  SUPER_ADMIN // owner / host — sees everything, can disable premium-only features
  ADMIN // site owner / regular administrator
  EDITOR // content: topics, sections, articles, pages, templates, menus, geo images
  MARKETING // + widgets, style guide, regions, feeds, reports
  REVIEWER // listing approval queue
  SALES_REP // leads, clients, invoices, merchants
  GRACE_COACH
  SUBSCRIBER // directory listing owner — self-service "My Listing" edit only
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role
  scope  String @default("all") // "all" | "own" (own leads only) — legacy allleads/allcompanies perms
  @@unique([userId, role])
}

// ---------------------------------------------------------------------------
// Localization universe (legacy tblRegions + hierarchy)
// ---------------------------------------------------------------------------

enum AreaPart {
  ALL
  NORTHERN
  SOUTHERN
  EASTERN
  WESTERN
  CENTRAL
}

model Region {
  id         String    @id // legacy RegionCode, e.g. "CA San Diego"
  tenantId   String
  state      String // "CA"
  stateFull  String // "California"
  city       String? // null = state row
  areaPart   AreaPart?
  slug       String    @unique // legacy DomainKey "San-Diego-California-CA"
  custom1    String? // localized intro HTML, tokens allowed
  custom2    String?
  priority   Int       @default(999)
  zipCodes   String[]  @default([])
  createdAt  DateTime  @default(now())
  categoryImages CategoryImage[]
  featuredPlacements FeaturedPlacement[]
  @@index([tenantId])
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String // legacy DomainKey, e.g. "wilderness-therapy"
  title       String
  description String? // category-level blob, tokens allowed (catalog description)
  author      String? // topic author name
  parentId    String? // legacy tblSearchCategoryParent / Sub hierarchy
  parent      Category? @relation("CatTree", fields: [parentId], references: [id])
  children    Category[] @relation("CatTree")
  stateInit   String? // state intro, {{region}} tokens allowed
  stateDesc   String?
  cityInit    String?
  cityDesc    String?
  altIntros   Json?  // areaPart-keyed overrides
  sections    Json?  // topic content sections [{title, content}, ...]
  status      String @default("LIVE")
  // SEO — parity with the Page content type (SeoFields: SEO / Advanced / Schema tabs).
  // seoTitle/metaDesc support {{region}} tokens: rendered per page on /g/* routes.
  seoTitle        String?
  metaDesc        String?
  metaKeywords    String? // JSON array of keywords
  focusKeyphrase  String?
  ogImage         String?
  canonicalUrl    String? // applies to the parent /g/{slug}/ page only; region pages self-canonicalize
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  jsonSchema      String? // JSON-LD injected on /g/* pages
  regionContent CategoryRegionContent[]
  regionFeeds    CategoryRegionFeed[]
  listingCategories ListingCategory[]
  contentTemplates  ContentTemplate[]
  contentSections Section[]
  images CategoryImage[]
  featuredPlacements FeaturedPlacement[]
  @@unique([tenantId, slug])
}

model CategoryRegionContent {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  state       String // 2-letter
  areaPart    AreaPart @default(NORTHERN)
  customText  String
  faq         Json @default("[]") // [{q, a}] — rendered + FAQPage JSON-LD on /g/* region pages
  @@unique([categoryId, state, areaPart])
}

model CategoryRegionFeed {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  state       String
  areaPart    AreaPart @default(NORTHERN)
  feedId      String
  feed        Feed     @relation(fields: [feedId], references: [id])
}

// ---------------------------------------------------------------------------
// Directory listings + paid tier + suppression (legacy §4.1, §4.10 → §6.7)
// ---------------------------------------------------------------------------

enum ListingTier {
  SUPPRESSED // admin opt-out — NEVER rendered
  FREE // migrated legacy listings: hidden after grace period
  STANDARD // paid, listed
  PREMIUM // paid, featured
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  SUSPENDED // unpaid / dunning
  EXPIRED
}

model Listing {
  id           String        @id @default(cuid())
  tenantId     String
  tier         ListingTier   @default(FREE)
  status       ListingStatus @default(DRAFT) // mirrors ListingSubscription.status when paid
  title        String
  slug         String        @unique
  domainKey    String? // drives exclusion matching (e.g. "clearview-horizon")
  contentHtml  String?
  keywords     String?
  description  String?
  isArticlePage Boolean      @default(false)
  articleTemplate String?
  isLandingPage Boolean      @default(false)
  freeGraceUntil DateTime? // FREE listings stay visible until this migration grace end

  companyId    String?       // profile-owned listing
  companyName  String?
  phone        String?
  email        String?
  website      String?
  address      String?
  city         String?
  state        String?
  zip          String?
  lat          Float?        // for map/geo search
  lng          Float?        // for map/geo search

  avatarImage  String?
  feedImage    String?
  videoUrl     String?
  galleryImages Json @default("[]") // additional images
  summary      String?
  staff        String?
  clientFocus  String?
  credentials  String?
  isSlidingScale Boolean     @default(false)
  freeInitial   Boolean      @default(false)
  acceptsPayment Json @default("{}") // ACH/Amex/Cash/... legacy flags
  hasMalpractice Boolean     @default(false)
  social       Json          @default("{}") // FB/TW/YT/LI/IG/GP/Pinterest/Quora
  ageGroups    Json          @default("{}")
  clientGender String?
  religion     String?
  languages    Json          @default("[]")
  pricing      Json          @default("{}") // structured pricing tiers
  specialties   Json @default("[]") // list of specialties/services
  amenities     Json @default("[]") // list of amenities
  certifications Json @default("[]") // licenses/certifications
  insuranceAccepted Json @default("[]") // insurance providers
  hoursOfOperation Json @default("{}") // weekly schedule

  authorId     String?       // legacy UserID (staff page)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Verification & Claim
  claimedById  String?       // User who claimed this listing
  claimedAt    DateTime?
  verificationToken String? // for email verification
  verificationExpires DateTime?
  verifiedAt   DateTime?     // when phone/email/license verified
  verifiedFields Json @default("[]") // which fields verified

  // Featured/Monetization
  featuredUntil DateTime?    // featured placement expiry
  featuredSlots Int @default(0) // number of featured slots purchased
  featuredPosition Int?      // position in featured carousel

  // Lead Capture
  leadEmail    String?       // where to send leads
  leadPhone    String?       // phone for lead notifications
  leadFormFields Json @default("{}") // custom lead form config
  leadNotificationEmail Boolean @default(true)
  leadNotificationSms Boolean @default(false)
  leadAutoResponder Json @default("{}") // auto-responder config

  // Analytics
  viewCount    Int @default(0)
  clickCount   Int @default(0)
  leadCount    Int @default(0)
  lastViewedAt DateTime?

  // Reviews/Aggregates
  reviewCount  Int @default(0)
  averageRating Float @default(0)

  // SEO
  seoTitle     String?
  metaDesc     String?
  focusKeyphrase String?
  ogImage      String?
  canonicalUrl String?
  robotsIndex  Boolean @default(true)
  robotsFollow Boolean @default(true)
  jsonSchema   String? // custom JSON-LD

  // Badges/Verification
  badges       Json @default("[]") // earned badges: verified, top_rated, years_in_business, etc.

  categories   ListingCategory[]
  regions      ListingRegion[]
  subscription ListingSubscription?
  articles     SearchArticle[]
  merchants    Merchant[]
  reviews      Review[]
  leads        ListingLead[]
  analytics    ListingAnalytic[]
  featuredPlacementPurchases FeaturedPlacementPurchase[]
  leadCredits  LeadCredit[]
  webhookDeliveries WebhookDelivery[]
  verificationRequests VerificationRequest[]
  @@index([tenantId, tier, status])
  @@index([tenantId, slug])
  @@index([tenantId, city, state])
  @@index([tenantId, claimedById])
}

model ListingCategory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  @@unique([listingId, categoryId])
}

model ListingRegion {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  regionId  String // legacy "Nearby Areas" — recommend 3–5 per listing
  @@unique([listingId, regionId])
}

model ExcludedCompany {
  id          String   @id @default(cuid())
  tenantId    String
  companyName String
  domainKey   String? // auto-matches future listings
  listingId   String?
  reason      String?
  addedById   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([tenantId, isActive])
}

model ListingSubscription {
  id               String        @id @default(cuid())
  listingId        String        @unique
  listing          Listing       @relation(fields: [listingId], references: [id])
  tier             ListingTier
  status           ListingStatus
  stripeCustomerId String?
  stripeSubId      String?      @unique
  priceId          String?
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  paymentGraceUntil DateTime?
  approvedById     String?
  approvedAt       DateTime?
  canceledAt       DateTime?
  createdAt        DateTime      @default(now())
}

model Review {
  id          String   @id @default(cuid())
  tenantId    String
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId    String?  // User who wrote the review
  authorName  String?  // for anonymous/guest reviews
  authorEmail String?  // for verification
  rating      Int      // 1-5
  title       String?
  content     String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, FLAGGED
  isVerified  Boolean  @default(false) // verified purchase/lead
  helpfulCount Int     @default(0)
  response    String?  // owner response
  respondedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, listingId])
  @@index([tenantId, status])
  @@index([listingId, status])
}

model ListingAnalytic {
  id        String   @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  views     Int      @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)
  calls     Int      @default(0)
  emails    Int      @default(0)
  directions Int     @default(0)
  websiteClicks Int  @default(0)
  createdAt DateTime @default(now())

  @@unique([listingId, date])
  @@index([tenantId, date])
  @@index([listingId, date])
}

model ListingLead {
  id          String   @id @default(cuid())
  tenantId    String
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  message     String?
  subject     String?
  source      String   @default("listing") // listing, contact_form, claim, etc.
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  assignedToId String?
  metadata    Json     @default("{}") // form data, utm params, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, listingId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Localization content: templates → per-region variants (§6.5)
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  SCHEDULED
  LIVE
  DISABLED
}

model ContentTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  slug        String   @default("")
  title       String // one piece of content, e.g. "Wilderness Therapy for Troubled Teen Girls"
  body        String // tokens: {{region}} {{in region}} {{around region}} {{near region}} ...
  metaDesc    String?
  author      String? // subtopic author name
  featuredImageAssetId String? @unique // FK to Asset for featured image
  featuredImage Asset? @relation(fields: [featuredImageAssetId], references: [id])
  displaySections Json? // boolean array [s1, s2, s3, s4, s5] for topic section visibility
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // SEO fields
  seoTitle        String?
  metaKeywords    String? // JSON array of keywords
  focusKeyphrase  String?
  ogImage         String?
  canonicalUrl    String?
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  jsonSchema      String? // JSON-LD schema
  variants    ContentVariant[]
  sectionLinks SubTopicSection[]
  @@unique([tenantId, slug])
}

model ContentVariant {
  id         String        @id @default(cuid())
  templateId String
  template   ContentTemplate @relation(fields: [templateId], references: [id])
  regionId   String // one row per selected region (materialized on publish)
  body       String // rendered output with region substituted
  status     ContentStatus @default(DRAFT)
  publishAt  DateTime? // per-region scheduling (new vs legacy)
  revision   Int          @default(1)
  createdAt  DateTime     @default(now())
  @@unique([templateId, regionId])
}

// ---------------------------------------------------------------------------
// Feeds / articles / topics (legacy §4.3)
// ---------------------------------------------------------------------------

model Feed {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  domainKey     String?
  url           String? // ingestion source (RSS/Atom); null → manual curation only
  type          String   @default("RSS") // RSS | ATOM
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  lastFetchedAt DateTime?
  lastError     String?
  items         FeedItem[]
  categories    CategoryRegionFeed[]
}

model FeedItem {
  id          String   @id @default(cuid())
  feedId      String
  feed        Feed     @relation(fields: [feedId], references: [id])
  fingerprint String   @unique // sha1 of title|url|feedDate — ingestion idempotency
  title       String
  url         String?
  body        String?
  author      String?
  keywords    String? // feed categories / tags; matched by curation
  feedDate    DateTime?
  status      String   @default("NEW") // NEW | APPROVED | TRASHED
  curatedAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([feedId, feedDate])
}

model SearchArticle {
  id          String   @id @default(cuid())
  tenantId    String
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id])
  authorId    String?
  title       String
  body        String? // tokens allowed → may become ContentTemplate
  domainKey   String?
  metaDesc    String?
  tags        String?
  feedImage   String?
  isApproved  Boolean  @default(false)
  isRejected  Boolean  @default(false)
  reviewedById String?
  reviewedAt  DateTime?
  postDate    DateTime?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Leads / clients / billing (legacy §4.5, §4.6 — trimmed for Phase 0)
// ---------------------------------------------------------------------------

model Lead {
  id            String   @id @default(cuid())
  tenantId      String
  firstName     String?
  lastName      String?
  email         String?
  phones        Json     @default("{}")
  addresses     Json     @default("{}")
  status        String   @default("NEW") // disposition lifecycle
  disposition   String?
  initialDisposition String?
  statusDate    DateTime?
  lastModified  DateTime @updatedAt
  assignedToId  String? // legacy CSUserID
  closeUserId   String?
  campaignId    String?
  productId     String?
  publisherId   String?
  subId         String?
  clickId       String?
  landingPageId String?
  // clinical intake (legacy extended fields)
  intake        Json     @default("{}") // patient/insurance/diagnosis/trauma/court flags...
  createdAt     DateTime @default(now())
  notes         LeadNote[]
  todos         ToDo[]
  @@index([tenantId, status])
}

model LeadNote {
  id      String   @id @default(cuid())
  leadId  String
  lead    Lead     @relation(fields: [leadId], references: [id])
  note    String
  userId  String?
  createdAt DateTime @default(now())
}

model ToDo {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  assigneeId String?
  text      String
  dueAt     DateTime?
  finishedAt DateTime?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String?
  lastName  String?
  email     String?
  phones    Json     @default("{}")
  addresses Json     @default("{}")
  maskedCard String? // legacy First4/Last4/MaskedCard
  leadId    String?
  campaignId String?
  productId String?
  publisherId String?
  subId     String?
  clickId   String?
  landingPageId String?
  isPartial Boolean  @default(false)
  createdAt DateTime @default(now())
  invoices  Invoice[]
  @@index([tenantId])
}

model Invoice {
  id            String  @id @default(cuid())
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id])
  amount        Decimal
  chargeDate    DateTime?
  status        String // ATTEMPTED/APPROVED/DECLINED/ERROR/REFUNDED/CHARGEDBACK
  isRecurring   Boolean @default(false)
  interval      String? // legacy BillInterval
  retries       Int     @default(0)
  stripePaymentId String?
  responseMsg   String?
  createdAt     DateTime @default(now())
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Stripe Connect merchant pool (legacy §4.6) — programs paid out via Connect.
// ---------------------------------------------------------------------------

model Merchant {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  contactName     String?
  email           String?
  listingId       String? // the paid-listing operator, when they are one
  listing         Listing? @relation(fields: [listingId], references: [id])
  stripeAccountId String? // Connect account (acct_...)
  status          String   @default("INACTIVE") // ACTIVE | INACTIVE
  payoutMethod    String? // CHECK | ACH | CARD | STRIPE_CONNECT (legacy method)
  feePercent      Decimal  @default(0)
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CMS + audit + ops (legacy §4.7, §4.9)
// ---------------------------------------------------------------------------

model Page {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  slug            String   @default("")
  title           String   @default("")
  status          String   @default("DRAFT") // DRAFT | LIVE | DISABLED
  isHomepage      Boolean  @default(false)
  layout          String?
  data            String? // builder blocks JSON
  // SEO fields
  seoTitle        String?
  metaDesc        String?
  metaKeywords    String? // JSON array of keywords
  focusKeyphrase  String?
  ogImage         String?
  canonicalUrl    String?
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  jsonSchema      String? // JSON-LD schema
  revisions       PageRevision[]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  @@unique([tenantId, slug])
}

model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      String // builder blocks JSON snapshot
  createdAt DateTime @default(now())
  @@index([pageId, createdAt])
}

model Snippet {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  block     Json // builder block snapshot (rows may contain nested blocks)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, updatedAt])
}

// ---------------------------------------------------------------------------
// Header / Footer Builder
// ---------------------------------------------------------------------------

model HeaderFooter {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String   // "HEADER" | "FOOTER"
  data        String?  // builder blocks JSON (Block[])
  isDefault   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  revisions   HeaderFooterRevision[]
  assignments HeaderFooterAssignment[]
  @@unique([tenantId, name])
  @@index([tenantId, type])
}

model HeaderFooterRevision {
  id             String       @id @default(cuid())
  headerFooterId String
  headerFooter   HeaderFooter @relation(fields: [headerFooterId], references: [id], onDelete: Cascade)
  data           String       // builder blocks JSON snapshot
  createdAt      DateTime     @default(now())
  @@index([headerFooterId, createdAt])
}

model HeaderFooterAssignment {
  id             String       @id @default(cuid())
  tenantId       String
  headerFooterId String
  headerFooter   HeaderFooter @relation(fields: [headerFooterId], references: [id], onDelete: Cascade)
  priority       Int          @default(0) // higher = more specific
  pageId         String?      // null = global or type-level
  pageType       String?      // null = global or page-level ("blog", "landing", etc.)
  createdAt      DateTime     @default(now())
  @@unique([tenantId, headerFooterId, pageId, pageType])
  @@index([tenantId, headerFooterId])
}

// ---------------------------------------------------------------------------
// Page Layout Builder
// ---------------------------------------------------------------------------

model PageLayout {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  data        String?  // builder blocks JSON (Block[] + containerSettings)
  isDefault   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  revisions   PageLayoutRevision[]
  assignments PageLayoutAssignment[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

model PageLayoutRevision {
  id             String       @id @default(cuid())
  pageLayoutId   String
  pageLayout     PageLayout   @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  data           String       // builder blocks JSON snapshot
  createdAt      DateTime     @default(now())
  @@index([pageLayoutId, createdAt])
}

model PageLayoutAssignment {
  id             String       @id @default(cuid())
  tenantId       String
  pageLayoutId   String
  pageLayout     PageLayout   @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  priority       Int          @default(0) // higher = more specific
  pageId         String?      // null = global or type-level
  pageType       String?      // null = global or page-level ("blog", "landing", etc.)
  createdAt      DateTime     @default(now())
  @@unique([tenantId, pageLayoutId, pageId, pageType])
  @@index([tenantId, pageLayoutId])
}
model BlogTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String   @default("listing") // "listing" | "single"
  data        String?  // builder blocks JSON (Block[] + containerSettings)
  isDefault   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  revisions   BlogTemplateRevision[]
  assignments BlogTemplateAssignment[]
  
  @@unique([tenantId, name, type])
  @@index([tenantId, type])
}

model BlogTemplateRevision {
  id              String       @id @default(cuid())
   blogTemplateId  String
   blogTemplate    BlogTemplate @relation(fields: [blogTemplateId], references: [id], onDelete: Cascade)
   data            String       // builder blocks JSON snapshot
   createdAt       DateTime     @default(now())
   @@index([blogTemplateId, createdAt])
}

model BlogTemplateAssignment {
  id              String       @id @default(cuid())
   tenantId        String
   blogTemplateId  String
   blogTemplate    BlogTemplate @relation(fields: [blogTemplateId], references: [id], onDelete: Cascade)
   priority        Int          @default(0) // higher = more specific
   pageId          String?      // null = global or type-level
   pageType        String?      // null = global or page-level ("blog", "article")
   createdAt       DateTime     @default(now())
  @@unique([tenantId, blogTemplateId, pageId, pageType])
  @@index([tenantId, blogTemplateId])
}

model GeoCategoryTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String   @default("single") // "single" (reserved for future template types)
  layout      String   @default("FULLWIDTH") // "FULLWIDTH" | "SIDEBAR" default variation
  data        String?  // builder blocks JSON (Block[] + containerSettings)
  isDefault   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  revisions   GeoCategoryTemplateRevision[]
  assignments GeoCategoryTemplateAssignment[]

  @@unique([tenantId, name, type])
  @@index([tenantId, type])
}

model GeoCategoryTemplateRevision {
  id                   String                @id @default(cuid())
  geoCategoryTemplateId String
  geoCategoryTemplate  GeoCategoryTemplate   @relation(fields: [geoCategoryTemplateId], references: [id], onDelete: Cascade)
  data                 String                // builder blocks JSON snapshot
  createdAt            DateTime              @default(now())
  @@index([geoCategoryTemplateId, createdAt])
}

model GeoCategoryTemplateAssignment {
  id                   String                @id @default(cuid())
  tenantId             String
  geoCategoryTemplateId String
  geoCategoryTemplate  GeoCategoryTemplate   @relation(fields: [geoCategoryTemplateId], references: [id], onDelete: Cascade)
  priority             Int                   @default(0) // higher = more specific
  pageId               String?               // GeoCategory id (per-page assignment)
  pageType             String?               // "geoCategory" (type-level assignment)
  createdAt            DateTime              @default(now())
  @@unique([tenantId, geoCategoryTemplateId, pageId, pageType])
  @@index([tenantId, geoCategoryTemplateId])
}

// Product Template - similar to BlogTemplate for single product pages
model ProductTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  type            String   @default("single") // "single" for product detail page
  data            String?  // builder blocks JSON (Block[] + containerSettings)
  isDefault       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  revisions       ProductTemplateRevision[]
  assignments     ProductTemplateAssignment[]
  
  @@unique([tenantId, name, type])
  @@index([tenantId, type])
}

model ProductTemplateRevision {
  id              String       @id @default(cuid())
  productTemplateId String
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  data              String       // builder blocks JSON snapshot
  createdAt         DateTime     @default(now())
  @@index([productTemplateId, createdAt])
}

model ProductTemplateAssignment {
  id              String       @id @default(cuid())
  tenantId        String
  productTemplateId String
  productTemplate   ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  priority        Int          @default(0) // higher = more specific
  pageId          String?      // null = global or type-level
  pageType        String?      // null = global or page-level ("product", etc.)
  createdAt       DateTime     @default(now())
  @@unique([tenantId, productTemplateId, pageId, pageType])
  @@index([tenantId, productTemplateId])
}

model Asset {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String   @default("image") // image | file
  mimeType  String
  size      Int
  bytes     Bytes
  filename  String?
  title     String?
  alt       String?
  caption   String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  @@index([tenantId])
  widgets Widget[]
  categoryImages CategoryImage[]
  subTopicFeaturedImage ContentTemplate?
  productImages ProductImage[]
  productCategoryImages ProductCategory[]
  productAttributeTermImages ProductAttributeTerm[]
  productVariantImages ProductVariant[]
}

/// A user-uploaded font file, grouped into a CSS family by `family`.
/// Each row is one weight/style variant of that family; every row emits its own
/// `@font-face` rule, so a family needs one row per weight it ships.
model CustomFont {
  id        String   @id @default(cuid())
  tenantId  String
  family    String // CSS family name, e.g. "Canopy Display"
  weight    String   @default("400") // "100".."900" or "variable"
  style     String   @default("normal") // normal | italic
  mono      Boolean  @default(false) // use a monospace fallback in generated stacks
  mimeType  String
  size      Int
  bytes     Bytes
  filename  String?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, family, weight, style])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String // SUPPRESS_ADD, LISTING_APPROVE, REFUND, TIER_CHANGE ...
  entity    String // entity type
  entityId  String
  reason    String?
  meta      Json?
  createdAt DateTime @default(now())
  @@index([tenantId, entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Admin content features (Phase B)
// ---------------------------------------------------------------------------

// Named content sections (grouping of topics/content on the site).
model Section {
  id         String   @id @default(cuid())
  tenantId   String
  slug       String
  title      String
  heading    String?
  body       String? // HTML/intro for the section
  order      Int      @default(0)
  status     String   @default("LIVE") // LIVE | DRAFT | HIDDEN
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  subTopicLinks SubTopicSection[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, slug])
  @@index([tenantId, order])
}

// The site owner's company profile + installed tracking/verification tags.
model SubTopicSection {
  id         String   @id @default(cuid())
  templateId String
  template   ContentTemplate @relation(fields: [templateId], references: [id])
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  order      Int      @default(0)
  @@unique([templateId, sectionId])
}

model Company {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String
  tagline               String?
  description           String?
  businessHours         Json     @default("{}") // { sunday:{opens,closes}, monday:{opens,closes}, ... }
  industryCategory      String?  // e.g. "Organization"
  industrySubCategory   String?  // e.g. "Educational Organization"
  industrySubSubCategory String? // e.g. "College/University"
  audiencePersona1      String?
  audiencePersona2      String?
  audiencePersona3      String?
  languagesSpoken       String?
  additionalLanguage    String?
  contactInfo           Json     @default("{}") // { phone, phoneLink, additionalPhone, fax, email, address, city, state, zip, country, mapLinkUrl, mapEmbedUrl }
  ga4                   String?  // GA4 measurement id
  gtm                   String?  // GTM container id
  fbPixel               String?  // Meta/Facebook pixel id
  searchConsole         String?  // Google Search Console site/verification
  gscVerificationTag    String?  // GSC <meta> verification content
  brandColor            String?
  logoAssetId           String?
  socialMedia           Json     @default("{}") // { facebook, twitter, youtube, instagram, linkedin, pinterest }
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation("CompanyTenant", fields: [tenantId], references: [id])
  linkedTenants         Tenant[] @relation("TenantCompanyId")
  widgets               Widget[]
  @@unique([tenantId])
}

// A named navigation menu rendered at a page location.
model Menu {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  location  MenuLocation @default(HEADER)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@unique([tenantId, name])
  @@index([tenantId, location])
}

enum MenuLocation {
  HEADER
  FOOTER
  SIDEBAR
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId String?
  label    String
  href     String
  order    Int     @default(0)
  target   String? // "_blank" etc.
  itemType String  @default("LINK") // LINK | FEED
  parent   MenuItem? @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemTree")
  @@index([menuId, order])
}

// A free-form HTML "widget" (ad/promo block) with an optional featured image
// and an optional redirect target.
model Widget {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  title        String?  // display title
  url          String?  // widget URL / page url
  html         String // free-form HTML content
  imageAssetId String? // featured image (asset id)
  redirectUrl  String?
  keywords     String?  // comma-separated tags
  companyId    String?  // FK to Company
  company      Company? @relation(fields: [companyId], references: [id])
  ctaDescription String? // CTA description text
  ctaStatement1  String? // CTA statement line 1
  ctaStatement2  String? // CTA statement line 2
  ctaButtonText  String? // CTA button label
  phone        String?  // phone number
  usePhoneAsButtonLink Boolean @default(false) // use phone as button link
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?
  youtubeUrl   String?
  pinterestUrl String?
  linkedinUrl  String?
  active       Boolean  @default(true)
  placements   WidgetPlacement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  imageAsset   Asset? @relation(fields: [imageAssetId], references: [id])
  @@index([tenantId, active])
}

model WidgetPlacement {
  id       String @id @default(cuid())
  widgetId String
  widget   Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  slot     String // e.g. "SIDEBAR_TOP", "INLINE", "FOOTER"
  order    Int    @default(0)
  active   Boolean @default(true)
  @@index([slot, active])
}

// Category/region-specific image overrides (hero, intro, listing artwork).
model CategoryImage {
  id           String  @id @default(cuid())
  tenantId     String
  categoryId   String?
  regionId     String?
  imageAssetId String
  position     String  @default("PRIMARY") // PRIMARY | BANNER | THUMB
  order        Int     @default(0)
  isPrimary    Boolean @default(false)
  createdAt    DateTime @default(now())
  category     Category? @relation(fields: [categoryId], references: [id])
  region       Region? @relation(fields: [regionId], references: [id])
  imageAsset   Asset @relation(fields: [imageAssetId], references: [id])
  @@index([tenantId, categoryId, regionId])
}

// Rate-limiting for login attempts (serverless-safe, no in-memory state).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  @@unique([email])
  @@index([email, resetAt])
}
// ---------------------------------------------------------------------------
// E-Commerce (products, orders, carts, payments)
// ---------------------------------------------------------------------------

enum ProductType {
  SIMPLE
  VARIABLE
  SUBSCRIPTION
  SERVICE
  EXTERNAL
  GROUPED
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PRIVATE
}

enum ProductVisibility {
  PUBLIC
  PRIVATE
  MEMBERS
  HIDDEN
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_BACKORDER
  LOW_STOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  ON_HOLD
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentGatewayType {
  STRIPE
  PAYPAL
  SQUARE
  MANUAL
}

enum CouponType {
  PERCENT
  FIXED_CART
  FIXED_PRODUCT
  FREE_SHIPPING
}

enum ShippingMethodType {
  FLAT_RATE
  FREE_SHIPPING
  LOCAL_PICKUP
}

enum TaxCalculationMethod {
  NONE
  STANDARD
  REDUCED
  ZERO_RATED
  EXEMPT
}

model ShippingClass {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  @@index([tenantId])
}

model ProductCategory {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  slug           String          @unique
  description    String?
  parentId       String?
  parent         ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("CategoryTree")
  imageAssetId   String?
  imageAsset     Asset?          @relation(fields: [imageAssetId], references: [id])
  displayType    String?
  menuOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  showInMenu     Boolean         @default(true)
  seoTitle       String?
  metaDesc       String?
  focusKeyphrase String?
  ogImage        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       ProductCategoryLink[]
  @@index([tenantId])
}

model ProductCategoryLink {
  id         String          @id @default(cuid())
  productId  String
  categoryId String
  isPrimary  Boolean         @default(false)
  position   Int             @default(0)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([productId, categoryId])
  @@index([categoryId])
}

model ProductAttribute {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  type         String   @default("select")
  order        Int      @default(0)
  isVariation  Boolean  @default(false)
  isVisible    Boolean  @default(true)
  isFilterable Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  terms           ProductAttributeTerm[]
  attributeValues ProductAttributeValue[]
  @@index([tenantId])
}

model ProductAttributeTerm {
  id            String   @id @default(cuid())
  attributeId   String
  name          String
  slug          String
  description   String?
  menuOrder     Int      @default(0)
  count         Int      @default(0)
  imageAssetId  String?
  meta          Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  attribute       ProductAttribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  imageAsset      Asset?              @relation(fields: [imageAssetId], references: [id])
  attributeValues ProductAttributeValue[]
  @@index([attributeId])
}

model ProductTag {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  products      ProductTagLink[]
  @@index([tenantId])
}

model ProductTagLink {
  id        String      @id @default(cuid())
  productId String
  tagId     String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([productId, tagId])
  @@index([tagId])
}

model Product {
  id                    String          @id @default(cuid())
  tenantId              String
  type                  ProductType     @default(SIMPLE)
  status                ProductStatus   @default(DRAFT)
  visibility            ProductVisibility @default(PUBLIC)
  name                  String
  slug                  String          @unique
  sku                   String?
  shortDescription      String?
  description           String?
  regularPrice          Float           @default(0)
  salePrice             Float?
  salePriceStart        DateTime?
  salePriceEnd          DateTime?
  price                 Float           @default(0)
  taxStatus             TaxCalculationMethod @default(STANDARD)
  taxClass              String?
  stockStatus           StockStatus     @default(IN_STOCK)
  stockQuantity         Float?
  manageStock           Boolean         @default(false)
  backorders            String          @default("no")
  lowStockAmount        Float?
  soldIndividually      Boolean         @default(false)
  weight                Float?
  length                Float?
  width                 Float?
  height                Float?
  shippingClassId       String?
  shippingRequired      Boolean         @default(true)
  shippingTaxable       Boolean         @default(true)
  externalUrl           String?
  externalButtonText    String?
  subscriptionPeriod    String?
  subscriptionInterval  Int?
  subscriptionLength    Int?
  subscriptionTrialPeriod Int?
  subscriptionSignUpFee Float?
  membershipAccess      String?
  membershipDuration    String?
  serviceDuration       Int?
  serviceBufferBefore   Int?
  serviceBufferAfter    Int?
  serviceMaxBookings    Int?
  serviceLocation       String?
  serviceCalendarId     String?
  commissionRate        Float?
  commissionType        String?
  vendorId              String?
  downloadable          Boolean         @default(false)
  downloadLimit         Int?
  downloadExpiry        Int?
  downloadFiles         Json            @default("[]")
  virtual               Boolean         @default(false)
  reviewsAllowed        Boolean         @default(true)
  averageRating         Float?
  reviewCount           Int             @default(0)
  seoTitle              String?
  metaDesc              String?
  focusKeyphrase        String?
  ogImage               String?
  canonicalUrl          String?
  purchaseNote          String?
  menuOrder             Int             @default(0)
  featured              Boolean         @default(false)
  catalogVisibility     String          @default("visible")
  dateOnSaleFrom        DateTime?
  dateOnSaleTo          DateTime?
  publishedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  shippingClass ShippingClass?       @relation(fields: [shippingClassId], references: [id])
  vendor        User?                @relation("ProductVendor", fields: [vendorId], references: [id])
  categories    ProductCategoryLink[]
  attributes    ProductAttributeValue[]
  images        ProductImage[]
  variants      ProductVariant[]
  customFields  ProductCustomField[]
  tags          ProductTagLink[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  subscriptions Subscription[]
  commissions   Commission[]
  comparedIn    ProductComparisonItem[]
  @@index([tenantId, status])
  @@index([tenantId, featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  assetId   String
  alt       String?
  position  Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id])
  @@index([productId])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String?
  name            String?
  regularPrice    Float    @default(0)
  salePrice       Float?
  price           Float    @default(0)
  stockStatus     StockStatus @default(IN_STOCK)
  stockQuantity   Float?
  manageStock     Boolean  @default(false)
  backorders      String   @default("no")
  lowStockAmount  Float?
  weight          Float?
  length          Float?
  width           Float?
  height          Float?
  imageAssetId    String?
  downloadable    Boolean  @default(false)
  downloadLimit   Int?
  downloadExpiry  Int?
  downloadFiles   Json     @default("[]")
  virtual         Boolean  @default(false)
  description     String?
  purchaseNote    String?
  menuOrder       Int      @default(0)
  attributes      Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageAsset  Asset?              @relation(fields: [imageAssetId], references: [id])
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  subscriptions Subscription[]
  @@index([productId])
}

model ProductCustomField {
  id        String   @id @default(cuid())
  productId String
  key       String
  label     String
  value     String
  type      String   @default("text")
  options   Json?
  group     String?
  position  Int      @default(0)
  isPublic  Boolean  @default(true)
  isRequired Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model ProductAttributeValue {
  id          String   @id @default(cuid())
  productId   String
  attributeId String
  termId      String?
  customValue String?
  isVisible   Boolean  @default(true)
  isVariation Boolean  @default(false)
  position    Int      @default(0)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  term        ProductAttributeTerm? @relation(fields: [termId], references: [id])
  @@index([productId])
  @@index([attributeId])
}

model Cart {
  id            String   @id @default(cuid())
  tenantId      String
  sessionId     String?
  userId        String?
  currency      String   @default("USD")
  couponCode    String?
  shippingTotal Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  itemCount     Int      @default(0)
  expiresAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user   User?   @relation(fields: [userId], references: [id])
  coupon Coupon? @relation(fields: [couponCode], references: [code])
  items  CartItem[]
  @@index([tenantId, sessionId])
  @@index([tenantId, userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  price     Float    @default(0)
  lineTotal Float    @default(0)
  taxTotal  Float    @default(0)
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([cartId])
}

model Order {
  id                 String        @id @default(cuid())
  tenantId           String
  orderNumber        String        @unique
  parentOrderId      String?
  customerId         String?
  userId             String?
  guestEmail         String?
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  fulfillmentStatus  String        @default("unfulfilled")
  currency           String        @default("USD")
  currencyRate       Float         @default(1)
  subtotal           Float         @default(0)
  taxTotal           Float         @default(0)
  shippingTotal      Float         @default(0)
  discountTotal      Float         @default(0)
  feeTotal           Float         @default(0)
  total              Float         @default(0)
  refundedAmount     Float         @default(0)
  paymentGatewayId   String?
  paymentMethod      String?
  paymentMethodTitle String?
  transactionId      String?
  billingFirstName   String?
  billingLastName    String?
  billingCompany     String?
  billingAddress1    String?
  billingAddress2    String?
  billingCity        String?
  billingState       String?
  billingPostcode    String?
  billingCountry     String?
  billingPhone       String?
  billingEmail       String?
  shippingFirstName  String?
  shippingLastName   String?
  shippingCompany    String?
  shippingAddress1   String?
  shippingAddress2   String?
  shippingCity       String?
  shippingState      String?
  shippingPostcode   String?
  shippingCountry    String?
  shippingPhone      String?
  shippingMethod     String?
  shippingMethodId   String?
  shippingTaxRate    Float?
  customerNote       String?
  adminNote          String?
  paidAt             DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  meta               Json          @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  parent           Order?          @relation("OrderTree", fields: [parentOrderId], references: [id])
  children         Order[]         @relation("OrderTree")
  customer         User?           @relation("OrderCustomer", fields: [customerId], references: [id])
  user             User?           @relation("OrderUser", fields: [userId], references: [id])
  paymentGateway   PaymentGateway? @relation(fields: [paymentGatewayId], references: [id])
  items            OrderItem[]
  transactions     PaymentTransaction[]
  notes            OrderNote[]
  refunds          Refund[]
  shipments        Shipment[]
  subscriptions    Subscription[]
  commissions      Commission[]
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  parentItemId    String?
  name            String
  sku             String?
  type            ProductType @default(SIMPLE)
  quantity        Int         @default(1)
  price           Float       @default(0)
  lineSubtotal    Float       @default(0)
  lineSubtotalTax Float       @default(0)
  lineTotal       Float       @default(0)
  lineTax         Float       @default(0)
  taxClass        String?
  taxRate         Float?
  meta            Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  @@index([orderId])
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  userId            String?
  type              String   @default("general")
  content           String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  @@index([orderId])
}

model Refund {
  id              String    @id @default(cuid())
  orderId         String
  amount          Float
  reason          String?
  status          String    @default("pending")
  gatewayRefundId String?
  refundedById    String?
  items           Json      @default("[]")
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundedBy User? @relation(fields: [refundedById], references: [id])
  @@index([orderId])
}

model Shipment {
  id              String    @id @default(cuid())
  orderId         String
  trackingNumber  String?
  trackingUrl     String?
  carrier         String?
  status          String    @default("pending")
  shippedAt       DateTime?
  deliveredAt     DateTime?
  shippingAddress Json      @default("{}")
  items           Json      @default("[]")
  meta            Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model PaymentGateway {
  id                       String              @id @default(cuid())
  tenantId                 String
  type                     PaymentGatewayType  @default(STRIPE)
  name                     String
  slug                     String
  isEnabled                Boolean             @default(false)
  isTestMode               Boolean             @default(true)
  priority                 Int                 @default(0)
  config                   Json                @default("{}")
  supportedCurrencies      String[]            @default([])
  supportedCountries       String[]            @default([])
  minAmount                Float?
  maxAmount                Float?
  allowedProductTypes      ProductType[]       @default([])
  connectAccountId         String?
  connectOnboardingComplete Boolean            @default(false)
  webhookSecret            String?
  webhookUrl               String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  transactions  PaymentTransaction[]
  orders        Order[]
  subscriptions Subscription[]
  @@unique([tenantId, slug])
  @@index([tenantId, isEnabled])
}

model PaymentTransaction {
  id                  String        @id @default(cuid())
  tenantId            String
  gatewayId           String
  orderId             String?
  customerId          String?
  amount              Float
  currency            String        @default("USD")
  status              PaymentStatus @default(PENDING)
  gatewayTransactionId String?
  gatewayResponse     Json          @default("{}")
  refundedAmount      Float         @default(0)
  refundedAt          DateTime?
  refundReason        String?
  description         String?
  metadata            Json          @default("{}")
  errorMessage        String?
  errorCode           String?
  requiresAction      Boolean       @default(false)
  actionUrl           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  gateway   PaymentGateway @relation(fields: [gatewayId], references: [id])
  order     Order?         @relation(fields: [orderId], references: [id])
  customer  User?          @relation(fields: [customerId], references: [id])
  @@index([tenantId, status])
  @@index([orderId])
}

model Coupon {
  id                    String    @id @default(cuid())
  tenantId              String
  code                  String    @unique
  type                  CouponType @default(PERCENT)
  amount                Float     @default(0)
  description           String?
  minAmount             Float?
  maxAmount             Float?
  individualUse         Boolean   @default(false)
  excludeSaleItems      Boolean   @default(false)
  usageLimit            Int?
  usageLimitPerUser     Int       @default(0)
  usedCount             Int       @default(0)
  productIds            String[]  @default([])
  excludedProductIds    String[]  @default([])
  categoryIds           String[]  @default([])
  excludedCategoryIds   String[]  @default([])
  startDate             DateTime?
  endDate               DateTime?
  freeShipping          Boolean   @default(false)
  isActive              Boolean   @default(true)
  meta                  Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  carts Cart[]
  @@index([tenantId])
}

model Subscription {
  id                    String   @id @default(cuid())
  tenantId              String
  orderId               String
  customerId            String
  productId             String
  variantId             String?
  gatewaySubscriptionId String?
  gatewayId             String?
  status                String   @default("active")
  interval              String   @default("month")
  intervalCount         Int      @default(1)
  trialEndsAt           DateTime?
  currentPeriodStart    DateTime @default(now())
  currentPeriodEnd      DateTime
  cancelledAt           DateTime?
  endedAt               DateTime?
  amount                Float    @default(0)
  currency              String   @default("USD")
  quantity              Int      @default(1)
  meta                  Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  order     Order           @relation(fields: [orderId], references: [id])
  customer  User            @relation(fields: [customerId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  gateway   PaymentGateway? @relation(fields: [gatewayId], references: [id])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

model Commission {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String
  vendorId    String
  affiliateId String?
  amount      Float    @default(0)
  rate        Float    @default(0)
  type        String   @default("percentage")
  status      String   @default("pending")
  payoutId    String?
  paidAt      DateTime?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order     Order     @relation(fields: [orderId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  vendor    User      @relation("CommissionVendor", fields: [vendorId], references: [id])
  affiliate User?     @relation("CommissionAffiliate", fields: [affiliateId], references: [id])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
}

model TaxRate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  country   String
  state     String?
  rate      Float    @default(0)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([tenantId, country])
}

model Wishlist {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String   @default("My Wishlist")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user  User           @relation(fields: [userId], references: [id])
  items WishlistItem[]
  @@index([tenantId, userId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  wishlistId  String
  productId   String
  variantId   String?
  addedAt     DateTime @default(now())
  wishlist    Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  @@unique([wishlistId, productId, variantId])
  @@index([productId])
}

model ProductComparison {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String   @unique
  productIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comparedProducts ProductComparisonItem[]
  @@index([tenantId])
}

model ProductComparisonItem {
  id           String   @id @default(cuid())
  comparisonId String
  productId    String
  position     Int      @default(0)
  comparison   ProductComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([comparisonId, productId])
  @@index([productId])
}

// ============================================================================
// Featured Placement / Monetization
// ============================================================================

enum FeaturedPlacementType {
  HOME_HERO           // Homepage hero carousel (1 slot)
  HOME_FEATURED       // Homepage featured grid (3 slots)
  CATEGORY_TOP        // Category page top banner (1 per category)
  CATEGORY_FEATURED   // Category featured grid (3 per category)
  REGION_SPOTLIGHT    // Region page spotlight (1 per region)
  SEARCH_TOP          // Search results top (2 slots)
}

enum FeaturedPlacementStatus {
  AVAILABLE
  RESERVED
  ACTIVE
  EXPIRED
  CANCELLED
}

model FeaturedPlacement {
  id          String                @id @default(cuid())
  tenantId    String
  type        FeaturedPlacementType
  slug        String                // e.g. "home-hero", "category-wilderness-therapy-top"
  label       String                // Display name: "Homepage Hero", "Wilderness Therapy Top Banner"
  description String?
  
  // Pricing
  priceMonthly   Float
  priceQuarterly Float?
  priceAnnually  Float?
  currency       String   @default("USD")
  
  // Slot configuration
  maxSlots      Int     @default(1)
  currentSlots  Int     @default(0)
  
  // Targeting
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  regionId      String?
  region        Region?   @relation(fields: [regionId], references: [id])
  
  // Status & Timing
  status        FeaturedPlacementStatus @default(AVAILABLE)
  startsAt      DateTime?
  endsAt        DateTime?
  
  // Metadata
  metadata      Json    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  purchases     FeaturedPlacementPurchase[]
  
  @@unique([tenantId, slug])
  @@index([tenantId, type, status])
  @@index([tenantId, categoryId, regionId])
}

model FeaturedPlacementPurchase {
  id                  String   @id @default(cuid())
  tenantId            String
  placementId         String
  placement           FeaturedPlacement @relation(fields: [placementId], references: [id])
  listingId           String
  listing             Listing   @relation(fields: [listingId], references: [id])
  
  // Pricing snapshot
  pricePaid           Float
  currency            String   @default("USD")
  billingInterval     String   // MONTHLY, QUARTERLY, ANNUALLY
  
  // Stripe
  stripeCustomerId    String?
  stripeSubscriptionId String?  @unique
  stripePriceId       String?
  
  // Status
  status              String   @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, EXPIRED
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelledAt         DateTime?
  
  // Position in carousel (if applicable)
  position            Int?
  
  // Metadata
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([tenantId, listingId])
  @@index([tenantId, placementId])
  @@index([stripeSubscriptionId])
}

model LeadCredit {
  id            String   @id @default(cuid())
  tenantId      String
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  // Credit balance
  balance       Int      @default(0) // number of leads remaining
  usedThisMonth Int      @default(0)
  monthStart    DateTime @default(now())
  
  // Subscription tier limits
  monthlyLimit  Int      @default(10) // included leads per month
  
  // Overages
  overageCount  Int      @default(0)
  overageRate   Float    @default(2.00) // price per overage lead
  
  // Metadata
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([tenantId, listingId])
  @@index([tenantId])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  url         String
  secret      String   // signing secret
  events      String[] // e.g., ["lead.created", "lead.updated", "order.paid"]
  isActive    Boolean  @default(true)
  secretKey   String?  // for HMAC verification
  
  // Retry config
  maxRetries  Int      @default(3)
  retryDelay  Int      @default(60) // seconds
  
  // Stats
  successCount Int     @default(0)
  failureCount Int     @default(0)
  lastTriggeredAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  deliveries  WebhookDelivery[]
  
  @@index([tenantId, isActive])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  endpointId      String
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  
  event           String
  payload         Json
  responseStatus  Int?
  responseBody    String?
  attempt         Int      @default(1)
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED, GIVEN_UP
  
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, status])
  @@index([endpointId, status])
  @@index([tenantId, createdAt])
  @@index([listingId])
}

enum VerificationType {
  EMAIL
  PHONE
  LICENSE
  IDENTITY
  BUSINESS_LICENSE
  INSURANCE
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model VerificationRequest {
  id              String           @id @default(cuid())
  tenantId        String
  listingId       String
  listing         Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestedById   String           // User who requested verification
  type            VerificationType
  status          VerificationStatus @default(PENDING)
  
  // Verification data
  documentUrl     String?          // URL to uploaded document
  documentType    String?          // e.g., "license", "insurance", "id_card"
  documentNumber  String?          // License number, etc.
  expirationDate  DateTime?        // When the verification expires
  
  // Review
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  
  // Metadata
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([tenantId, listingId])
  @@index([tenantId, status])
  @@index([tenantId, type])
}
