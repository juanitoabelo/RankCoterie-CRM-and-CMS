# =============================================================================
# Canopy V2 — Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
CATALOG_REPO=prisma
INNGEST_DEV=1
SITE_URL="http://localhost:3000"

# Admin back office (shared secret until Auth.js lands)
ADMIN_SECRET="dev-only-admin-secret-change-me"

# ---------------------------------------------------------------------------
# Stripe — TEST MODE (Phase 2 verification)
# ---------------------------------------------------------------------------
# Get test keys from: https://dashboard.stripe.com/test/apikeys
#
# IMPORTANT: Use test-mode keys (sk_test_* / pk_test_*), NOT live keys.
# Live keys will NOT work with the test card numbers below.

# Secret key for server-side Stripe API calls
STRIPE_SECRET_KEY="sk_test_YOUR_SECRET_KEY_HERE"

# Publishable key for client-side (checkout.js, etc.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_PUBLISHABLE_KEY_HERE"

# Webhook signing secret — run `stripe listen --forward-to localhost:3111/api/webhooks/stripe`
# and copy the signing secret from the terminal output
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# Price IDs — create these in Stripe Dashboard → Products
# Standard tier: monthly subscription price
STRIPE_PRICE_STANDARD="price_YOUR_STANDARD_PRICE_ID"

# Premium tier: monthly subscription price
STRIPE_PRICE_PREMIUM="price_YOUR_PREMIUM_PRICE_ID"

# Setup fee: one-time charge applied at checkout
STRIPE_SETUP_FEE_ID="price_YOUR_SETUP_FEE_PRICE_ID"

# ---------------------------------------------------------------------------
# Stripe Test Cards (for E2E verification)
# ---------------------------------------------------------------------------
# Use these in Stripe Checkout test mode:
#
# 4242 4242 4242 4242  — Successful payment
# 4000 0000 0000 0002  — Declined (simulate payment_failed webhook)
# 4000 0000 0000 9995  — Card rejected (signup fails, no checkout)
# 4000 0025 0000 3155  — Requires authentication (3D Secure)
#
# For simulating webhook events without real cards:
#   stripe trigger checkout.session.completed
#   stripe trigger invoice.payment_failed
#   stripe trigger customer.subscription.deleted
