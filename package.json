{
  "name": "canopy-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Canopy V2 monorepo — paid SEO directory + lead-gen + CRM platform (Next.js)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "test": "npm run test --workspace=web",
    "db:generate": "npm run db:generate --workspace=db",
    "migrate:legacy": "npx tsx scripts/migrate-legacy.ts",
    "migrate:verify": "npx tsx scripts/verify-migration.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3111/api/webhooks/stripe",
    "stripe:e2e": "npm run test --workspace=web -- --testPathPattern=stripe-e2e",
    "verify:stripe": "npx tsx scripts/verify/stripe.ts",
    "verify:paypal": "npx tsx scripts/verify/paypal.ts",
    "verify:square": "npx tsx scripts/verify/square.ts",
    "verify:all": "npx tsx scripts/verify/all.ts",
    "config:track": "npx tsx scripts/admin-config-tracker.ts"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "mysql2": "^3.24.4",
    "playwright": "^1.64.0"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true
  }
}
